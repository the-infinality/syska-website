# This project currently has no required environment variables.
#
# The contact form (see src/app/api/contact/route.ts) saves submissions to
# a local file at data/contact-submissions.txt instead of sending email, so
# nothing needs to be configured for it to work.
#
# Note: that file-based approach only works when running on a machine with
# a writable filesystem (e.g. `npm run dev` / `npm run start`) — it will not
# work on Vercel, since serverless functions there have a read-only
# filesystem. If the contact form is switched back to sending email via
# Resend, these are the variables it used to read:
#
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=
